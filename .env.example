# Copy this file to .env and fill in your own values. Never commit .env to GitHub.

# Required for the real agent (python -m src.agent_app)
FOUNDRY_PROJECT_ENDPOINT=https://your-foundry-service.services.ai.azure.com/api/projects/your-foundry-project
FOUNDRY_MODEL=your-model-deployment-name

# Optional: use Azure AI Search as the capability registry instead of registry/capabilities.json
# REGISTRY_BACKEND=azure_search
# AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
# AZURE_SEARCH_INDEX=capability-registry

# Optional: print traces in the terminal (console) or send to an OTLP endpoint (otlp)
# TRACING=console
