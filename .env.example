# Copy this file to .env and fill in your own values. Never commit .env to GitHub.

# Choose where the model comes from:
#   offline = no model, no cost (web app and offline demo)   github = free, rate limited
#   ollama = free, local   foundry = billed (python -m src.agent_app default)
MODEL_PROVIDER=offline

# --- github: free tier. Create a fine-grained token at github.com/settings/tokens with Models: Read-only ---
GITHUB_TOKEN=paste-your-github-token-here
# Pick a tool-calling model from the GitHub Models marketplace and use its exact id:
GITHUB_MODEL=openai/gpt-4.1-mini

# --- ollama: free and local (install Ollama, then `ollama pull llama3.1`) ---
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# --- foundry: needed only if MODEL_PROVIDER=foundry ---
FOUNDRY_PROJECT_ENDPOINT=https://your-foundry-service.services.ai.azure.com/api/projects/your-foundry-project
FOUNDRY_MODEL=your-model-deployment-name

# Optional: use Azure AI Search as the capability registry instead of registry/capabilities.json
# REGISTRY_BACKEND=azure_search
# AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
# AZURE_SEARCH_INDEX=capability-registry

# Optional: print traces in the terminal (console) or send to an OTLP endpoint (otlp)
# TRACING=console
